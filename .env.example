# Backend LLM : il en faut AU MOINS UNE des deux.
# GOOGLE_API_KEY est prioritaire si les deux sont presentes.

# Google AI Studio (tier gratuit, sans CB) - https://aistudio.google.com/apikey
# A ne pas confondre avec un abonnement Gemini Pro : l'abonnement ne donne
# aucun quota API, il ne vaut que dans l'interface AI Studio et l'app Gemini.
GOOGLE_API_KEY=AIza...

# OpenRouter (payant, repli) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Token Genius (obligatoire pour les paroles) - https://genius.com/api-clients
GENIUS_API_TOKEN=...

# Optionnel : override du modele de decodage.
# Defaut selon le provider : gemini-3.6-flash (Google), google/gemini-2.5-flash
# (OpenRouter). Ne pas viser un modele Gemini 2.x sur un projet Google recent,
# ils sont fermes aux nouveaux utilisateurs et repondent 404.
GEMINI_MODEL=

# Optionnel : modele du second decodeur (OpenRouter uniquement)
DEEPSEEK_MODEL=deepseek/deepseek-v4-pro

# Mettre a 1 quand OpenRouter est credite : les appels qui exigent une recherche
# web (tracklists, discographies, contexte d'album) repartent alors chez Sonar,
# pendant que le decodage continue sur Google. Sans ce drapeau et avec une cle
# Google active, ces appels tombent sur Gemini qui repond de memoire — le mode
# Album echoue alors sur les artistes peu references.
SEARCH_VIA_OPENROUTER=1
