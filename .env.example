# Backend LLM : il en faut AU MOINS UNE des deux.
# GOOGLE_API_KEY est prioritaire si les deux sont presentes.

# Google AI Studio (tier gratuit, sans CB) - https://aistudio.google.com/apikey
# A ne pas confondre avec un abonnement Gemini Pro : l'abonnement ne donne
# aucun quota API, il ne vaut que dans l'interface AI Studio et l'app Gemini.
GOOGLE_API_KEY=AIza...

# OpenRouter (payant, repli) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Token Genius (obligatoire pour les paroles) - https://genius.com/api-clients
GENIUS_API_TOKEN=...

# Optionnel : override des modeles (valeurs par defaut ci-dessous)
GEMINI_MODEL=google/gemini-2.5-flash
DEEPSEEK_MODEL=deepseek/deepseek-r1-0528
